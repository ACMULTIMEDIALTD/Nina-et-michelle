{% assign is_he = false %}{% if request.locale.iso_code == 'he' %}{% assign is_he = true %}{% endif %}
<div class="container">
  <div class="page-intro">
    <div>
      <h1>{{ 'journal.title' | t }}</h1>
      <p class="intro-sub">{{ 'journal.subtitle' | t }}</p>
    </div>
    <nav class="filter-tabs" aria-label="Journal categories">
      <a href="{{ blog.url }}" {% unless current_tags %}class="active"{% endunless %}>{{ 'journal.all' | t }}</a>
      {% for tag in blog.all_tags %}
        <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}class="active"{% endif %}>{{ tag }}</a>
      {% endfor %}
    </nav>
  </div>

  {% paginate blog.articles by 9 %}
    {% for article in blog.articles limit: 3 %}
      <article class="feature-article{% cycle '', ' reverse', '' %}">
        <a class="fa-media" href="{{ article.url }}">
          {% if article.image %}{{ article.image | image_url: width: 1200 | image_tag: alt: article.title }}{% endif %}
        </a>
        <div class="fa-body">
          <div class="fa-meta">
            {% if article.tags.size > 0 %}<span class="label muted">{{ article.tags.first }}</span>{% endif %}
            <span class="label muted">{% if is_he %}{{ article.published_at | date: '%-d ב%B %Y' }}{% else %}{{ article.published_at | date: '%B %-d, %Y' }}{% endif %}</span>
          </div>
          <h2>{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          <a href="{{ article.url }}" class="link-cta">{{ 'general.read_more' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>
        </div>
      </article>
    {% endfor %}

    {% if blog.articles.size > 3 %}
      <div class="article-grid">
        {% for article in blog.articles offset: 3 %}
          <a href="{{ article.url }}" class="ag-card">
            <div class="j-img">{% if article.image %}{{ article.image | image_url: width: 800 | image_tag: alt: article.title }}{% endif %}</div>
            <div class="ag-meta">
              {% if article.tags.size > 0 %}<span class="label muted">{{ article.tags.first }}</span>{% endif %}
              <span class="label muted">{% if is_he %}{{ article.published_at | date: '%-d ב%B %Y' }}{% else %}{{ article.published_at | date: '%B %-d, %Y' }}{% endif %}</span>
            </div>
            <h3>{{ article.title }}</h3>
            <span class="link-cta">{{ 'general.read_more' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <div style="text-align:center; padding-bottom:80px;">
        {% if paginate.previous %}<a class="link-cta" href="{{ paginate.previous.url }}">{{ 'general.arrow_back' | t }} {{ 'general.previous' | t }}</a>{% endif %}
        {% if paginate.next %}<a class="link-cta" href="{{ paginate.next.url }}" style="margin-inline-start:30px;">{{ 'general.next' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>{% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
