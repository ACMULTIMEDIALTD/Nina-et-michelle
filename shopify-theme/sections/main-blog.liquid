<div class="container">
  <div class="page-intro">
    <div>
      <h1>{{ blog.title }}</h1>
      <p class="intro-sub">A journal of inspiration, our process, and the beauty of everyday essentials.</p>
    </div>
  </div>

  {% paginate blog.articles by 9 %}
    {% for article in blog.articles %}
      <article class="feature-article{% cycle '', ' reverse' %}">
        <a class="fa-media" href="{{ article.url }}">
          {% if article.image %}{{ article.image | image_url: width: 1200 | image_tag: alt: article.title }}{% endif %}
        </a>
        <div class="fa-body">
          <div class="fa-meta">
            {% if article.tags.size > 0 %}<span class="label muted">{{ article.tags.first }}</span>{% endif %}
            <span class="label muted">{{ article.published_at | date: '%B %-d, %Y' }}</span>
          </div>
          <h2>{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          <a href="{{ article.url }}" class="link-cta">Read More <span class="arrow">&#10230;</span></a>
        </div>
      </article>
    {% endfor %}

    {% if paginate.pages > 1 %}
      <div style="text-align:center; padding-bottom:80px;">
        {% if paginate.previous %}<a class="link-cta" href="{{ paginate.previous.url }}">&#10229; Previous</a>{% endif %}
        {% if paginate.next %}<a class="link-cta" href="{{ paginate.next.url }}" style="margin-inline-start:30px;">Next <span class="arrow">&#10230;</span></a>{% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
