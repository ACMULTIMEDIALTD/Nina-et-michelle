<div class="container">
  <div class="page-intro">
    <div>
      <h1>{{ 'contact.title' | t }}</h1>
      <p class="intro-sub">{{ 'contact.subtitle' | t }}</p>
    </div>
  </div>

  <div class="contact-layout">
    <div>
      <div class="contact-block">
        <h3>{{ 'contact.email' | t }}</h3>
        <p><a href="mailto:contact@ninaetmichelle.com">contact@ninaetmichelle.com</a></p>
      </div>
      <div class="contact-block">
        <h3>{{ 'contact.whatsapp' | t }}</h3>
        <p>{{ 'contact.whatsapp_text' | t }} <a href="https://wa.me/972506995056" target="_blank" rel="noopener" style="border-bottom:1px solid currentColor;">050-699-5056</a></p>
      </div>
      <div class="contact-block">
        <h3>{{ 'contact.shipping' | t }}</h3>
        <p>{{ 'contact.shipping_text' | t }} <a href="/pages/shipping-returns" style="border-bottom:1px solid currentColor;">{{ 'contact.full_details' | t }}</a></p>
      </div>
      <div class="contact-block">
        <h3>{{ 'contact.returns' | t }}</h3>
        <p>{{ 'contact.returns_text' | t }} <a href="/pages/shipping-returns#returns" style="border-bottom:1px solid currentColor;">{{ 'contact.read_policy' | t }}</a></p>
      </div>
      <div class="contact-block">
        <h3>{{ 'contact.follow' | t }}</h3>
        <p><a href="{{ settings.instagram_url | default: '#' }}" style="border-bottom:1px solid currentColor;">{{ 'contact.instagram' | t }}</a></p>
      </div>
    </div>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <p style="font-style:italic;">{{ 'contact.success' | t }}</p>
      {% else %}
        {% if form.errors %}
          <p style="color:#9a3b3b; margin-bottom:20px;">{{ 'contact.error' | t }}</p>
        {% endif %}
        <div class="form-row">
          <label for="cf-name">{{ 'contact.name' | t }}</label>
          <input type="text" id="cf-name" name="contact[name]" required>
        </div>
        <div class="form-row">
          <label for="cf-email">{{ 'contact.email_label' | t }}</label>
          <input type="email" id="cf-email" name="contact[email]" required>
        </div>
        <div class="form-row">
          <label for="cf-msg">{{ 'contact.message' | t }}</label>
          <textarea id="cf-msg" name="contact[body]" required></textarea>
        </div>
        <button type="submit" class="link-cta" style="background:none;border-top:none;border-inline:none;cursor:pointer;">{{ 'contact.send' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></button>
      {% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{ "name": "Contact", "settings": [] }
{% endschema %}
