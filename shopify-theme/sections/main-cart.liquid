{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}
<div class="container">
  <div class="page-intro">
    <div>
      <h1>{{ 'cart.title' | t }}</h1>
      {% if cart.item_count == 0 %}<p class="intro-sub">{{ 'cart.empty' | t }} <a href="{{ routes.all_products_collection_url }}" style="border-bottom:1px solid currentColor;">{{ 'cart.continue' | t }}</a>.</p>{% endif %}
    </div>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" style="padding-bottom:100px;">
      <div style="border-top:1px solid var(--hairline);">
        {% for item in cart.items %}
          <div style="display:grid; grid-template-columns:90px 1fr auto; gap:20px; align-items:center; padding:22px 0; border-bottom:1px solid var(--hairline);">
            <a href="{{ item.url }}">
              {% if item.image %}{{ item.image | image_url: width: 200 | image_tag: alt: item.title }}{% endif %}
            </a>
            <div>
              <p style="font-size:18px;">{{ item.product.title }}</p>
              {% unless item.product.has_only_default_variant %}<p style="font-size:13px; color:var(--muted); letter-spacing:0.08em;">{{ item.variant.title }}</p>{% endunless %}
              <div class="qty" style="margin-top:10px; display:inline-flex;">
                <button type="button" data-line="{{ forloop.index }}" data-change="-1" aria-label="{{ 'product.qty_decrease' | t }}">–</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'product.quantity' | t }}" style="height:40px;">
                <button type="button" data-line="{{ forloop.index }}" data-change="1" aria-label="{{ 'product.qty_increase' | t }}">+</button>
              </div>
            </div>
            <p style="font-size:17px;">{% render 'price', amount: item.final_line_price %}</p>
          </div>
        {% endfor %}
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:30px; flex-wrap:wrap; gap:20px;">
        <button type="submit" name="update" class="link-cta" style="background:none;border-top:none;border-inline:none;cursor:pointer;">{{ 'cart.update' | t }}</button>
        <div style="text-align:end;">
          <p style="font-size:22px; margin-bottom:6px;">{{ 'cart.subtotal' | t }} {% render 'price', amount: cart.total_price %}</p>
          {%- assign free_shipping_from = 50000 -%}
          <p style="font-size:13px; color:var(--muted); margin-bottom:16px;">
            {%- if cart.total_price >= free_shipping_from -%}
              {{ 'cart.note_free' | t }}
            {%- else -%}
              {%- assign remaining_amount = free_shipping_from | minus: cart.total_price -%}
              {%- capture remaining -%}{% render 'price', amount: remaining_amount %}{%- endcapture -%}
              {{ 'cart.note_remaining' | t: amount: remaining }}
            {%- endif -%}
          </p>
          <label id="AgreeWrap" style="display:flex; gap:10px; align-items:flex-start; font-size:14.5px; margin-bottom:18px; cursor:pointer; max-width:420px; margin-inline-start:auto; text-align:start;">
            <input type="checkbox" id="AgreeTerms" style="margin-top:4px; accent-color:var(--ink); width:16px; height:16px; flex-shrink:0;">
            <span>{{ 'cart.agree_html' | t: root: root }}</span>
          </label>
          <p id="AgreeError" style="display:none; color:#9a3b3b; font-size:13px; margin-bottom:14px;">{{ 'cart.agree_error' | t }}</p>
          <button type="submit" name="checkout" id="CheckoutBtn" class="btn btn-dark">{{ 'cart.checkout' | t }}</button>
          {%- if localization.available_languages.size > 1 -%}
            <p class="cart-lang">
              <span>{{ 'cart.checkout_language' | t }}</span>
              {%- for language in localization.available_languages -%}
                <button type="submit" form="CartLangForm" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == request.locale.iso_code %} class="is-current" aria-current="true"{% endif %}>{% if language.iso_code == 'he' %}עברית{% else %}English{% endif %}</button>
              {%- endfor -%}
            </p>
          {%- endif -%}
          <script>
            (function () {
              var btn = document.getElementById('CheckoutBtn');
              var box = document.getElementById('AgreeTerms');
              var err = document.getElementById('AgreeError');
              if (!btn || !box) return;
              btn.addEventListener('click', function (e) {
                if (!box.checked) {
                  e.preventDefault();
                  err.style.display = 'block';
                  document.getElementById('AgreeWrap').style.outline = '1px solid #9a3b3b';
                  document.getElementById('AgreeWrap').style.outlineOffset = '6px';
                }
              });
              box.addEventListener('change', function () {
                if (box.checked) {
                  err.style.display = 'none';
                  document.getElementById('AgreeWrap').style.outline = 'none';
                }
              });
            })();
          </script>
        </div>
      </div>
    </form>
    {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization', id: 'CartLangForm' -%}{%- endform -%}
    {%- endif -%}
  {% endif %}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
