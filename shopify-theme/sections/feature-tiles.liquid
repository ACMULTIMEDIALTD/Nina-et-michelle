<section class="feature-tiles">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="tile light" {{ block.shopify_attributes }}>
      <div class="tile-ph"></div>
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.heading, class: '' }}
      {% else %}
        {% if forloop.first %}
          <img src="https://acmultimedialtd.github.io/Nina-et-michelle/images/new-collection.jpg" alt="{{ block.settings.heading | strip_html }}" loading="lazy">
        {% else %}
          <img src="https://acmultimedialtd.github.io/Nina-et-michelle/images/fabric.jpg" alt="{{ block.settings.heading | strip_html }}" loading="lazy">
        {% endif %}
      {% endif %}
      <div class="tile-content">
        <span class="label">{{ block.settings.label }}</span>
        <h2>{{ block.settings.heading }}</h2>
        <span class="link-cta">{{ block.settings.cta }} <span class="arrow">&#10230;</span></span>
      </div>
    </a>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Feature tiles",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Small label", "default": "New Collection" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Timeless pieces, made to live in." },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Discover Now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Feature tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
