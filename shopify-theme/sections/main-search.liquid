<div class="container">
  <div class="page-intro">
    <div>
      <h1>Search</h1>
      {% if search.performed %}<p class="intro-sub">{{ search.results_count }} results for “{{ search.terms }}”</p>{% endif %}
    </div>
  </div>

  <form action="{{ routes.search_url }}" method="get" style="max-width:480px; margin-bottom:60px;">
    <div class="newsletter-form" style="margin:0;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search">
      <button type="submit">Search</button>
    </div>
  </form>

  {% if search.performed %}
    {% paginate search.results by 12 %}
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% endpaginate %}
  {% endif %}
</div>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
