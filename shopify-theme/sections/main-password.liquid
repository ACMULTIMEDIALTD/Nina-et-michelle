<section style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:40px 16px; gap:22px;">
  <span class="logo">{{ shop.name }}</span>
  <p class="label muted">The Fine Art of Basics</p>
  {% if shop.password_message != blank %}<p style="max-width:460px;">{{ shop.password_message }}</p>{% endif %}
  <details style="margin-top:28px;">
    <summary class="label" style="cursor:pointer;">{{ 'password.enter' | t }}</summary>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div style="display:flex; gap:10px; margin-top:16px; justify-content:center;">
        <input type="password" name="password" required aria-label="{{ 'password.label' | t }}" placeholder="{{ 'password.label' | t }}" style="padding:10px 14px; border:1px solid var(--ink); background:transparent; font-family:inherit;">
        <button type="submit" class="btn btn-dark">{{ 'password.submit' | t }}</button>
      </div>
    {% endform %}
  </details>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
