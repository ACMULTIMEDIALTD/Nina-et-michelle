{%- comment -%}
  Coming-soon page. Shopify shows it to visitors while the store is password-protected,
  so it disappears on its own at launch (Online Store > Preferences > remove password).
{%- endcomment -%}
{%- assign is_he = false -%}{%- if request.locale.iso_code == 'he' -%}{%- assign is_he = true -%}{%- endif -%}
<style>
  .cs { min-height: 100vh; display: grid; grid-template-columns: 1.05fr 1fr; background: var(--cream); }
  .cs-media { position: relative; overflow: hidden; background: #d9d0c0; }
  .cs-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: cs-zoom 24s ease-out both; }
  .cs-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(25,25,25,0) 55%, rgba(25,25,25,.28)); }
  .cs-media .cs-cap { position: absolute; inset-inline-start: 40px; bottom: 34px; z-index: 1; color: var(--cream); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; }
  .cs-body { display: flex; flex-direction: column; padding: 40px clamp(28px, 6vw, 96px); }
  .cs-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .cs-top .logo { font-size: 17px; }
  .cs-lang button { background: none; border: none; border-bottom: 1px solid transparent; cursor: pointer; color: inherit; font-family: inherit; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; padding: 0 0 3px; }
  .cs-lang button:hover { border-bottom-color: var(--ink); }
  .cs-main { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 56px 0; max-width: 520px; }
  .cs-main > * { animation: cs-rise 1.1s cubic-bezier(.2,.7,.2,1) both; }
  .cs-main > *:nth-child(2) { animation-delay: .15s; }
  .cs-main > *:nth-child(3) { animation-delay: .3s; }
  .cs-main > *:nth-child(4) { animation-delay: .45s; }
  .cs-title { font-size: clamp(64px, 9vw, 132px); line-height: .92; font-weight: 400; font-style: italic; letter-spacing: -.01em; margin: 22px 0 28px; }
  .cs-title span { display: block; font-style: normal; }
  .cs-lede { font-size: 19px; color: var(--ink-soft); max-width: 430px; }
  .cs-form { margin-top: 40px; }
  .cs-form .label { display: block; margin-bottom: 14px; }
  .cs-field { display: flex; border-bottom: 1px solid var(--ink); }
  .cs-field input { flex: 1; min-width: 0; border: none; background: transparent; padding: 14px 0; font-family: inherit; font-size: 17px; color: var(--ink); outline: none; }
  .cs-field input::placeholder { color: var(--muted); }
  .cs-field button { background: none; border: none; cursor: pointer; font-family: inherit; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink); padding: 0 0 0 16px; white-space: nowrap; }
  .cs-field button .arrow { display: inline-block; transition: transform .3s; }
  .cs-field button:hover .arrow { transform: translateX(6px); }
  .cs-note { margin-top: 14px; font-size: 14px; color: var(--muted); }
  .cs-note.ok { color: var(--ink); }
  .cs-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
  .cs-foot nav { display: flex; gap: 26px; }
  .cs-foot a:hover, .cs-owner summary:hover { color: var(--ink); }
  .cs-owner summary { cursor: pointer; list-style: none; }
  .cs-owner summary::-webkit-details-marker { display: none; }
  .cs-owner form { display: flex; gap: 10px; margin-top: 14px; }
  .cs-owner input { padding: 9px 12px; border: 1px solid var(--hairline); background: #fff; font-family: inherit; font-size: 14px; }
  .cs-owner button { padding: 9px 16px; border: 1px solid var(--ink); background: var(--ink); color: var(--cream); cursor: pointer; font-family: inherit; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }
  .cs-owner .errors { margin-top: 8px; color: #9a3b3b; text-transform: none; letter-spacing: 0; }
  @keyframes cs-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  @keyframes cs-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .cs-media img, .cs-main > * { animation: none; } }
  @media (max-width: 860px) {
    .cs { grid-template-columns: 1fr; }
    .cs-media { height: 46vh; order: -1; }
    .cs-media .cs-cap { inset-inline-start: 22px; bottom: 20px; }
    .cs-body { padding: 26px 22px 30px; }
    .cs-main { padding: 40px 0 44px; }
    .cs-lede { font-size: 17px; }
  }
  html[lang="he"] .cs-title { font-family: 'Frank Ruhl Libre', serif; font-style: normal; font-weight: 300; line-height: 1; }
  html[lang="he"] .cs-lede, html[lang="he"] .cs-field input { font-family: 'Frank Ruhl Libre', serif; }
  html[lang="he"] .cs-form .label, html[lang="he"] .cs-field button, html[lang="he"] .cs-foot, html[lang="he"] .cs-media .cs-cap { font-family: 'Assistant', sans-serif; font-size: 13px; letter-spacing: .04em; }
  html[lang="he"] .cs-field button { padding: 0 16px 0 0; }
  html[lang="he"] .cs-field button .arrow { transform: scaleX(-1); }
  html[lang="he"] .cs-field button:hover .arrow { transform: scaleX(-1) translateX(6px); }
</style>

<main class="cs">
  <div class="cs-media">
    <img src="{{ 'new-collection.jpg' | asset_url }}" width="1254" height="1254" alt="{{ 'password.image_alt' | t }}">
    <span class="cs-cap">{{ 'password.caption' | t }}</span>
  </div>

  <div class="cs-body">
    <header class="cs-top">
      <span class="logo">{{ shop.name }}</span>
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'cs-lang' -%}
          {%- if is_he -%}
            <button type="submit" name="locale_code" value="en">English</button>
          {%- else -%}
            <button type="submit" name="locale_code" value="he" style="font-family:'Assistant',sans-serif; font-size:12px; letter-spacing:.08em;">עברית</button>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </header>

    <div class="cs-main">
      <span class="label muted">The Fine Art of Basics</span>
      <h1 class="cs-title">{{ 'password.title_html' | t }}</h1>
      <p class="cs-lede">{{ 'password.lede' | t }}</p>
      {%- form 'customer', class: 'cs-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, launch-list">
        <label class="label" for="CsEmail">{{ 'password.signup_label' | t }}</label>
        {%- if form.posted_successfully? -%}
          <p class="cs-note ok">{{ 'password.signup_success' | t }}</p>
        {%- else -%}
          <div class="cs-field">
            <input id="CsEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'password.email_placeholder' | t }}" aria-label="{{ 'password.email_placeholder' | t }}">
            <button type="submit">{{ 'password.signup_button' | t }} <span class="arrow">&#10230;</span></button>
          </div>
          {%- if form.errors -%}<p class="cs-note">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <footer class="cs-foot">
      <nav>
        {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{{ 'footer.instagram' | t }}</a>{%- endif -%}
        {%- if settings.whatsapp_number != blank -%}<a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ 'footer.whatsapp' | t }}</a>{%- endif -%}
        <a href="mailto:{{ shop.email }}">{{ 'footer.email' | t }}</a>
      </nav>
      <details class="cs-owner">
        <summary>{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password' -%}
          <input type="password" name="password" required aria-label="{{ 'password.label' | t }}" placeholder="{{ 'password.label' | t }}">
          <button type="submit">{{ 'password.submit' | t }}</button>
          {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- endform -%}
      </details>
    </footer>
  </div>
</main>

{% schema %}
{ "name": "Coming soon", "settings": [] }
{% endschema %}
