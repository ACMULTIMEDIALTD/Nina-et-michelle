<section class="about-hero">
  <span class="label muted">{{ 'about.label' | t }}</span>
  <h1>{{ 'about.heading_html' | t }}</h1>
</section>

<section class="container about-split">
  <div class="a-img"><img src="{{ 'atelier-wall.jpg' | asset_url }}" width="1254" height="1254" alt="{{ 'about.s1_heading' | t | strip_html }}" loading="lazy"></div>
  <div>
    <h2>{{ 'about.s1_heading' | t }}</h2>
    <p>{{ 'about.s1_p1' | t }}</p>
    <p>{{ 'about.s1_p2' | t }}</p>
    <p>{{ 'about.s1_p3' | t }}</p>
    <a href="{{ routes.root_url | append: '/blogs/journal/inside-the-atelier' | replace: '//', '/' }}" class="link-cta">{{ 'about.s1_cta' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>
  </div>
</section>

<section class="container about-split" id="care">
  <div>
    <h2>{{ 'about.s2_heading' | t }}</h2>
    <p>{{ 'about.s2_p1' | t }}</p>
    <p>{{ 'about.s2_p2' | t }}</p>
    <a href="{{ routes.root_url | append: '/blogs/journal/the-beauty-of-natural-fabrics' | replace: '//', '/' }}" class="link-cta">{{ 'about.s2_cta' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>
  </div>
  <div class="a-img"><img src="{{ 'fabric.jpg' | asset_url }}" width="1536" height="1024" alt="{{ 'about.s2_heading' | t | strip_html }}" loading="lazy"></div>
</section>

<section class="quote-band">
  <blockquote>{{ 'about.quote' | t }}</blockquote>
  <p class="sig">{{ 'about.signature' | t }}</p>
</section>

<section class="newsletter">
  <h2>{{ 'about.news_heading' | t }}</h2>
  <p>{{ 'about.news_text' | t }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="{{ 'about.news_placeholder' | t }}" required aria-label="{{ 'about.news_placeholder' | t }}">
    <button type="submit">{{ 'about.news_button' | t }}</button>
  {% endform %}
  <p class="form-note">{{ 'about.news_note' | t }}</p>
</section>

{% schema %}
{ "name": "About", "settings": [] }
{% endschema %}
