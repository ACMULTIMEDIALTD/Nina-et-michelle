<section class="about-hero">
  <span class="label muted">{{ 'about.label' | t }}</span>
  <h1>{{ 'about.heading' | t }}</h1>
</section>

<section class="container about-split">
  <div class="a-img"><img src="https://acmultimedialtd.github.io/Nina-et-michelle/images/atelier-wall.jpg" alt="{{ 'about.s1_heading' | t | strip_html }}" loading="lazy"></div>
  <div>
    <h2>{{ 'about.s1_heading' | t }}</h2>
    <p>{{ 'about.s1_p1' | t }}</p>
    <p>{{ 'about.s1_p2' | t }}</p>
    <p>{{ 'about.s1_p3' | t }}</p>
    <a href="/blogs/journal/inside-the-atelier" class="link-cta">{{ 'about.s1_cta' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>
  </div>
</section>

<section class="container about-split" id="care">
  <div>
    <h2>{{ 'about.s2_heading' | t }}</h2>
    <p>{{ 'about.s2_p1' | t }}</p>
    <p>{{ 'about.s2_p2' | t }}</p>
    <a href="/blogs/journal/the-beauty-of-natural-fabrics" class="link-cta">{{ 'about.s2_cta' | t }} <span class="arrow">{{ 'general.arrow' | t }}</span></a>
  </div>
  <div class="a-img"><img src="https://acmultimedialtd.github.io/Nina-et-michelle/images/fabric.jpg" alt="{{ 'about.s2_heading' | t | strip_html }}" loading="lazy"></div>
</section>

<section class="quote-band">
  <blockquote>{{ 'about.quote' | t }}</blockquote>
  <p class="sig">{{ 'about.signature' | t }}</p>
</section>

<section class="newsletter">
  <h2>{{ 'about.news_heading' | t }}</h2>
  <p>{{ 'about.news_text' | t }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="{{ 'about.news_placeholder' | t }}" required aria-label="{{ 'about.news_placeholder' | t }}">
    <button type="submit">{{ 'about.news_button' | t }}</button>
  {% endform %}
  <p class="form-note">{{ 'about.news_note' | t }}</p>
</section>

{% schema %}
{ "name": "About", "settings": [] }
{% endschema %}
