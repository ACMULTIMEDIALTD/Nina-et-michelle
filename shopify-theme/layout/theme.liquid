<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}"{% if request.locale.iso_code == 'he' %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if request.locale.iso_code == 'he' %}
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Frank+Ruhl+Libre:wght@400;500;700&family=Assistant:wght@300;400;600&display=swap" rel="stylesheet">
  {% else %}
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  {% endif %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>

  <div class="topbar">{% if request.locale.iso_code == 'he' %}{{ 'general.topbar' | t }}{% else %}{{ settings.announcement_text | default: 'Complimentary shipping on orders over ₪500' }}{% endif %}</div>

  <header class="site-header">
    <div class="container nav-wrap">
      <button class="menu-toggle" id="menuToggle" aria-label="{{ 'general.menu_open' | t }}"><span></span><span></span><span></span></button>
      <ul class="nav-links">
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'nav.shop' | t }}</a></li>
        <li><a href="{{ routes.collections_url }}">{{ 'nav.collections' | t }}</a></li>
        <li><a href="/pages/about">{{ 'nav.about' | t }}</a></li>
        <li><a href="{{ blog.url | default: '/blogs/journal' }}">{{ 'nav.journal' | t }}</a></li>
      </ul>
      <a href="{{ routes.root_url }}" class="logo">{{ shop.name }}</a>
      <ul class="nav-utils">
        {% if localization.available_languages.size > 1 %}
          <li>
            {% form 'localization', id: 'LangSwitch' %}
              {% if request.locale.iso_code == 'he' %}
                <button type="submit" name="locale_code" value="en" style="background:none;border:none;cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:inherit;padding:0 0 3px;border-bottom:1px solid transparent;">English</button>
              {% else %}
                <button type="submit" name="locale_code" value="he" style="background:none;border:none;cursor:pointer;font-family:'Assistant','EB Garamond',sans-serif;font-size:12px;letter-spacing:0.08em;color:inherit;padding:0 0 3px;border-bottom:1px solid transparent;">עברית</button>
              {% endif %}
            {% endform %}
          </li>
        {% endif %}
        <li class="hide-mobile"><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a></li>
        <li class="hide-mobile"><a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a></li>
        <li><a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} (<span id="cartCount">{{ cart.item_count }}</span>)</a></li>
      </ul>
    </div>
  </header>

  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
    <button class="nav-close" id="navClose" aria-label="{{ 'general.menu_close' | t }}">✕</button>
    <ul>
      <li><a href="{{ routes.all_products_collection_url }}">{{ 'nav.shop' | t }}</a></li>
      <li><a href="{{ routes.collections_url }}">{{ 'nav.collections' | t }}</a></li>
      <li><a href="/pages/about">{{ 'nav.about' | t }}</a></li>
      <li><a href="/blogs/journal">{{ 'nav.journal' | t }}</a></li>
      <li><a href="/pages/contact">{{ 'nav.contact' | t }}</a></li>
      {% if localization.available_languages.size > 1 %}
        <li>
          {% form 'localization', id: 'LangSwitchMobile' %}
            {% if request.locale.iso_code == 'he' %}
              <button type="submit" name="locale_code" value="en" style="background:none;border:none;cursor:pointer;font-family:inherit;font-size:15px;letter-spacing:0.3em;text-transform:uppercase;color:inherit;">English</button>
            {% else %}
              <button type="submit" name="locale_code" value="he" style="background:none;border:none;cursor:pointer;font-family:'Assistant',sans-serif;font-size:16px;letter-spacing:0.08em;color:inherit;">עברית</button>
            {% endif %}
          {% endform %}
        </li>
      {% endif %}
    </ul>
  </nav>

  <main>
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="logo">{{ shop.name }}</div>
        <p>© {{ 'now' | date: '%Y' }} {{ 'footer.rights' | t }}</p>
      </div>
      <div>
        <h5>{{ 'footer.shop' | t }}</h5>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">{{ 'footer.all_products' | t }}</a></li>
          <li><a href="/collections/tops">{{ 'footer.tops' | t }}</a></li>
          <li><a href="/collections/bottoms">{{ 'footer.bottoms' | t }}</a></li>
          <li><a href="/collections/sets">{{ 'footer.sets' | t }}</a></li>
        </ul>
      </div>
      <div>
        <h5>{{ 'footer.about' | t }}</h5>
        <ul>
          <li><a href="/pages/about">{{ 'footer.our_story' | t }}</a></li>
          <li><a href="/blogs/journal/the-beauty-of-natural-fabrics">{{ 'footer.materials' | t }}</a></li>
          <li><a href="/pages/about#care">{{ 'footer.care' | t }}</a></li>
        </ul>
      </div>
      <div>
        <h5>{{ 'footer.help' | t }}</h5>
        <ul>
          <li><a href="/pages/shipping-returns">{{ 'footer.shipping' | t }}</a></li>
          <li><a href="/pages/shipping-returns#returns">{{ 'footer.returns' | t }}</a></li>
          <li><a href="/pages/faq">{{ 'footer.faq' | t }}</a></li>
          <li><a href="/pages/size-guide">{{ 'footer.size_guide' | t }}</a></li>
        </ul>
      </div>
      <div>
        <h5>{{ 'footer.follow' | t }}</h5>
        <ul>
          {% if settings.instagram_url != blank %}<li><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{{ 'footer.instagram' | t }}</a></li>{% endif %}
          {% if settings.whatsapp_number != blank %}<li><a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ 'footer.whatsapp' | t }}</a></li>{% endif %}
          <li><a href="mailto:{{ shop.email }}">{{ 'footer.email' | t }}</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>{{ shop.name }}</span>
      <nav>
        <a href="/pages/terms">{{ 'footer.terms' | t }}</a>
        <a href="/pages/privacy">{{ 'footer.privacy' | t }}</a>
        <a href="/pages/accessibility">{{ 'footer.accessibility' | t }}</a>
      </nav>
    </div>
  </footer>

  {% if settings.whatsapp_number != blank %}
  <a class="wa-float" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp customer service">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
  </a>
  {% endif %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
