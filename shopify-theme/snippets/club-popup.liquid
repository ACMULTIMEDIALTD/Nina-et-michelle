{%- comment -%}
  Club sign-up popup: 10% off the first purchase. The visual is the brand's own artwork
  (assets/club-popup.jpg, text included); "JOIN NOW" on it opens the email panel.
  Opens once per visitor (localStorage), a few seconds after the first page view.
  Sign-ups become customers tagged "club"; the code is the WELCOME10 discount (once per customer).
{%- endcomment -%}
{%- form 'customer', id: 'ClubForm', class: 'club-form' -%}
  {%- assign club_posted = form.posted_successfully? -%}
  <div class="club" id="Club" role="dialog" aria-modal="true" aria-label="{{ 'club.aria' | t }}"{% if club_posted or form.errors %} data-open="now"{% endif %} hidden>
    <div class="club-backdrop" data-club-close></div>
    <div class="club-card{% if club_posted or form.errors %} is-joining{% endif %}">
      <img class="club-art" src="{{ 'club-popup.jpg' | asset_url }}" width="1320" height="1980" alt="{{ 'club.art_alt' | t }}">
      <button type="button" class="club-x" data-club-close aria-label="{{ 'club.close' | t }}">&times;</button>
      <button type="button" class="club-join" data-club-join>{{ 'club.join' | t }}</button>

      <div class="club-panel">
        {%- if club_posted -%}
          <p class="club-kicker">{{ 'club.success_title' | t }}</p>
          <p class="club-text">{{ 'club.success_text' | t }}</p>
          <div class="club-code">
            <span id="ClubCode">WELCOME10</span>
            <button type="button" class="club-copy" data-club-copy data-done="{{ 'club.copied' | t }}">{{ 'club.copy' | t }}</button>
          </div>
          <p class="club-small">{{ 'club.success_note' | t }}</p>
        {%- else -%}
          <p class="club-kicker">{{ 'club.panel_title' | t }}</p>
          <input type="hidden" name="contact[tags]" value="newsletter, club">
          <div class="club-field">
            <input id="ClubEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'club.email' | t }}" aria-label="{{ 'club.email' | t }}">
            <button type="submit" class="club-submit">{{ 'club.submit' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="club-small club-err">{{ form.errors | default_errors }}</p>{%- endif -%}
          <p class="club-small">{{ 'club.consent' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endform -%}

<style>
  .club { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 16px; }
  .club[hidden] { display: none; }
  .club-backdrop { position: absolute; inset: 0; background: rgba(20,16,12,.55); animation: club-fade .45s ease both; }
  .club-card { position: relative; width: min(440px, 100%, calc((100vh - 32px) * 0.6667)); aspect-ratio: 2 / 3; overflow: hidden; background: #9c8775; box-shadow: 0 30px 80px rgba(0,0,0,.35); animation: club-rise .6s cubic-bezier(.2,.7,.2,1) both; }
  .club-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .club-x { position: absolute; top: 8px; right: 12px; z-index: 3; background: none; border: none; color: #f4efe8; font-size: 30px; line-height: 1; cursor: pointer; text-shadow: 0 1px 6px rgba(0,0,0,.3); }
  /* sits exactly over the "JOIN NOW" box drawn in the artwork */
  .club-join { position: absolute; left: 30%; width: 40%; top: 86%; height: 4.8%; z-index: 2; background: transparent; border: none; cursor: pointer; color: transparent; font-size: 1px; overflow: hidden; transition: background .25s; }
  .club-join:hover, .club-join:focus-visible { background: rgba(255,255,255,.12); outline: none; }
  .club-panel { position: absolute; inset: auto 0 0 0; z-index: 2; padding: 26px 26px 22px; display: grid; gap: 12px; color: #f4efe8; text-align: center;
    background: linear-gradient(180deg, rgba(58,44,34,0) 0%, rgba(58,44,34,.82) 22%, rgba(48,36,28,.92) 100%);
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    transform: translateY(100%); opacity: 0; transition: transform .5s cubic-bezier(.2,.7,.2,1), opacity .4s; pointer-events: none; }
  .club-card.is-joining .club-panel { transform: none; opacity: 1; pointer-events: auto; padding-top: 60px; }
  .club-card.is-joining .club-join { display: none; }
  .club-kicker { font-family: 'EB Garamond', serif; font-size: 13px; letter-spacing: .32em; text-transform: uppercase; }
  .club-text { font-size: 15px; line-height: 1.5; }
  .club-field { display: grid; gap: 10px; }
  .club-field input { width: 100%; padding: 11px 2px; border: none; border-bottom: 1px solid rgba(244,239,232,.8); background: transparent; color: #f4efe8; font-family: inherit; font-size: 16px; text-align: center; outline: none; }
  .club-field input::placeholder { color: rgba(244,239,232,.7); }
  .club-submit { padding: 12px 18px; border: 1px solid #f4efe8; background: transparent; color: #f4efe8; cursor: pointer; font-family: 'EB Garamond', serif; font-size: 13px; letter-spacing: .3em; text-transform: uppercase; transition: background .25s, color .25s; }
  .club-submit:hover, .club-submit:focus-visible { background: #f4efe8; color: #3a2c22; outline: none; }
  .club-small { font-size: 11.5px; line-height: 1.5; color: rgba(244,239,232,.78); }
  .club-err { color: #ffd9cf; }
  .club-code { display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px dashed rgba(244,239,232,.85); padding: 10px 14px; }
  .club-code span { font-family: 'EB Garamond', serif; font-size: 22px; letter-spacing: .2em; }
  .club-copy { background: #f4efe8; color: #3a2c22; border: none; padding: 8px 12px; cursor: pointer; font-family: inherit; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }
  @keyframes club-fade { from { opacity: 0; } }
  @keyframes club-rise { from { opacity: 0; transform: translateY(18px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .club-backdrop, .club-card { animation: none; } .club-panel { transition: none; } }
  html[lang="he"] .club-kicker, html[lang="he"] .club-submit, html[lang="he"] .club-copy { font-family: 'Assistant', sans-serif; letter-spacing: .06em; font-size: 14px; }
  html[lang="he"] .club-text, html[lang="he"] .club-field input { font-family: 'Frank Ruhl Libre', serif; }
</style>

<script>
  (function () {
    var club = document.getElementById('Club');
    if (!club) return;
    var card = club.querySelector('.club-card');
    var KEY = 'nm_club_seen';
    function seen() { try { return localStorage.getItem(KEY); } catch (e) { return '1'; } }
    function remember() { try { localStorage.setItem(KEY, '1'); } catch (e) {} }
    function open() { club.hidden = false; var f = club.querySelector('.club-join, .club-copy'); if (f) f.focus(); }
    function close() { club.hidden = true; remember(); }
    club.querySelectorAll('[data-club-close]').forEach(function (el) { el.addEventListener('click', close); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !club.hidden) close(); });
    var join = club.querySelector('[data-club-join]');
    if (join) join.addEventListener('click', function () {
      card.classList.add('is-joining');
      var email = document.getElementById('ClubEmail');
      if (email) setTimeout(function () { email.focus(); }, 350);
    });
    var copy = club.querySelector('[data-club-copy]');
    if (copy) copy.addEventListener('click', function () {
      var code = document.getElementById('ClubCode').textContent;
      if (navigator.clipboard) navigator.clipboard.writeText(code).then(function () { copy.textContent = copy.getAttribute('data-done'); }, function () {});
    });
    if (club.getAttribute('data-open') === 'now') { remember(); open(); return; }
    if (!seen()) setTimeout(function () { if (!seen()) { remember(); open(); } }, 4000);
  })();
</script>
